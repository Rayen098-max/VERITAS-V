# ==========================================
# VERITAS-V Environment Configuration
# Copy this file to .env and insert your free keys
# ==========================================

# 1. Groq Cloud (Free tier from https://console.groq.com)
# Used for Whisper speech transcription and causal DAG reasoning
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_key_optional
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API (Free tier from https://aistudio.google.com)
# Used for high-resolution vision frame captioning & verification
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3-flash-preview

# 3. Pipeline Backend Routing
CAPTIONING_BACKEND=gemini
NARRATIVE_BACKEND=groq
CAUSAL_BACKEND=groq
VERIFICATION_BACKEND=gemini
EXPLAINABILITY_BACKEND=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# 4. Multi-modal Audio
DISABLE_AUDIO=false
TRANSCRIPT_CACHE_DIR=tmp
