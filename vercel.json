{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/frames/:path*",
      "destination": "https://veritas-v.onrender.com/frames/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://veritas-v.onrender.com/media/:path*"
    },
    {
      "source": "/output/:path*",
      "destination": "https://veritas-v.onrender.com/output/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
